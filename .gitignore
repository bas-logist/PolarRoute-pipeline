# Ignore everything
configs/waypoints.csv
html/index.html
logs/*
inputs/*
outputs/*

# docs
site/

# Ignore cylc files that will contain site and user-specific data
flow/global.cylc
environment.cylc

# Ignore workflow manager
/workflow-manager/
/wfmanager/recent.operational-polarroute/
/wfmanager/*.log

# Except folders
!logs/.gitkeep
!inputs/.gitkeep
!outputs/.gitkeep

# Stop users putting datastores/output locations into git, if they're working directly under the project repo
datastore
upload
checkpoint
outputs
staging
push

# Ignore all env files except the example
*.env

# IDE things
.vscode/*